# S3 Configuration
S3_ENDPOINT=https://your-s3-endpoint.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1

# S3 Key Prefix Filter (optional, only index files under this prefix)
# Example: S3_INDEX_PREFIX=documents/transcripts/
S3_INDEX_PREFIX=

# SQLite Database Path (optional, defaults to ./data/search.sqlite)
SQLITE_DB_PATH=./data/search.sqlite

# Job Runner URL (optional, defaults to http://localhost:3001)
JOB_RUNNER_URL=http://localhost:3001

# Sync Configuration
# Enable/disable periodic sync checks (optional, defaults to true)
SYNC_ENABLED=true
# Interval between sync checks in milliseconds (optional, defaults to 60000)
SYNC_CHECK_INTERVAL_MS=60000
